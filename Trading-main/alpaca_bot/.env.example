# Copy this file to .env and fill in your keys.
# Get keys from https://app.alpaca.markets/ -> Home -> API Keys
# IMPORTANT: paper and live accounts have DIFFERENT keys.

ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# true  = paper trading (fake money, safe)   <-- keep this until fully tested
# false = LIVE trading (real money)
ALPACA_PAPER=true
