# Copy this file to .env and fill in your keys. .env is git-ignored.
# Get keys from https://app.alpaca.markets/ -> Home -> API Keys
# IMPORTANT: paper and live accounts have DIFFERENT keys.

ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# true  = paper trading (fake money, safe)   <-- keep this until fully tested
# false = LIVE trading (real money)
ALPACA_PAPER=true


# ------------------------------------------------------------------ agent layer
# Everything below is OFF by default. Filling in a key does not turn anything
# on -- these change how the bot trades, so enabling is a separate, deliberate
# act. The transport, scheduler and capital allocator live in config.yaml.

# Signal fusion. Off, the strategy named in config.yaml decides alone. On, all
# five vote and the attention layer weighs them by regime fit and by how each
# has actually been performing. Accepts 1/true/yes/on; anything else is off.
TRADING_BOT_FUSION=off

# LLM risk reviewer. It sees only trades the rules have ALREADY approved, and
# can only veto one or shrink it -- never propose, never enlarge. With no
# advisor the bot runs rules-only, which is its normal behaviour.
#
#   none | openai | featherless | openrouter | groq | deepseek | ollama
#   | lmstudio | anthropic
#
# Any provider speaking OpenAI's /v1/chat/completions works. The endpoint is
# derived from the name above, so LLM_BASE_URL is only needed for something
# not on that list -- a proxy, or a local server on an unusual port.
TRADING_BOT_ADVISOR=none

LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1   # only if the name above cannot resolve it

# Reasoning models spend tokens thinking before they answer. Too low a budget
# and the reply is truncated mid-thought, arriving as empty content -- which is
# treated as "no objection" and silently reviews nothing. 2048 measured enough
# for a Qwen3-class model; a non-reasoning model ignores the headroom.
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT=60

# Fusion temperature. 0 is winner-take-all, which reproduces "run one strategy";
# high values average everything equally. 0.5 keeps the best-suited strategy
# dominant while leaving the others a real minority voice.
# TRADING_BOT_FUSION_TEMPERATURE=0.5

# Anthropic is the one provider with its own variables, because it is a
# different account with a different key format rather than an OpenAI-shaped
# endpoint. Only read when TRADING_BOT_ADVISOR=anthropic.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
